# ── PrintKey Pro — Variables de entorno ──────────────────────────
# Copia este archivo como .env y completa los valores

# Clave secreta para JWT (genera una aleatoria larga)
SECRET_KEY=cambia_esto_por_una_clave_larga_y_secreta_aleatoria

# MercadoPago — Obtener en https://www.mercadopago.com/developers/
# Usa el token de TEST primero, luego el de PRODUCCIÓN
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URLs del sitio (sin barra al final)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Google Sheets — Pega aquí el JSON de la cuenta de servicio (en una línea)
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# Nombre de la hoja de Google Sheets (no cambiar si ya existe)
GOOGLE_SHEET_NAME=PrintKeyPro_DB
